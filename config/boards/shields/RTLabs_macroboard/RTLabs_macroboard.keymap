#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/* Define Layer Indices */
#define DEFAULT 0
#define MEDIA   1
#define RGB_BT  2

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        status = "okay";
    };

    keymap {
        compatible = "zmk,keymap";

        /* 
         * Layer 0: Default / Numpad & Quick Access
         * -------------------------------------------------------------
         * [SW2: 7]     [SW3: 8]     [SW4: 9]     [SW5: TO(MEDIA)]
         * [SW6: 4]     [SW7: 5]     [SW8: 6]     [SW9: MO(RGB_BT)]
         * [SW10 Encoder Push: Play/Pause]
         * Encoder Rotation: Volume Up / Volume Down
         */
        default_layer {
            display-name = "NUMPAD";
            bindings = <
                &kp KP_N7    &kp KP_N8    &kp KP_N9    &to MEDIA
                &kp KP_N4    &kp KP_N5    &kp KP_N6    &mo RGB_BT
                &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* 
         * Layer 1: Media & Navigation
         * -------------------------------------------------------------
         * [SW2: Prev]  [SW3: Play]  [SW4: Next]  [SW5: TO(DEFAULT)]
         * [SW6: Left]  [SW7: Down]  [SW8: Up]    [SW9: Right]
         * [SW10 Encoder Push: Mute]
         * Encoder Rotation: Next Track / Previous Track
         */
        media_layer {
            display-name = "MEDIA";
            bindings = <
                &kp C_PREV   &kp C_PP     &kp C_NEXT   &to DEFAULT
                &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT
                &kp C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        /* 
         * Layer 2: RGB Underglow, Power & Bluetooth Controls
         * -------------------------------------------------------------
         * [SW2: RGB Tog]   [SW3: RGB Eff+]  [SW4: RGB Hue+]  [SW5: Ext Power / Output Tog]
         * [SW6: BT Sel 0]  [SW7: BT Sel 1]  [SW8: BT Clear]  [SW9: Trans (Hold)]
         * [SW10 Encoder Push: Enter Bootloader]
         * Encoder Rotation: Brightness Up / Brightness Down
         */
        rgb_bt_layer {
            display-name = "CONFIG";
            bindings = <
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &ext_power EP_TOG
                &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_CLR       &trans
                &bootloader
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};